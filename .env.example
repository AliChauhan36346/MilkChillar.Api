# ==========================================
# MilkChillar.Api - Production Environment Variables
# Use these environment variables when deploying to Render, Koyeb, Railway, or Docker
# ==========================================

# 1. ASP.NET Environment
ASPNETCORE_ENVIRONMENT=Production

# 2. Database Connection String (Supabase Session Pooler or direct connection)
ConnectionStrings__DefaultConnection=Host=aws-1-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.hnyoaqctfaetyqvpenek;Password=YOUR_SUPABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# 3. JWT Security Configuration
JwtSettings__SecretKey=your-very-long-secret-key-that-is-at-least-32-characters
JwtSettings__Issuer=MilkChillarIssuer
JwtSettings__Audience=MilkChillarAudience
JwtSettings__ExpiryMinutes=1440

# 4. CORS Allowed Origins (Comma-separated list of your frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,https://chuhandaries189.vercel.app,https://your-custom-domain.com

# 5. Swagger UI in Production (Set to false if you want to disable documentation in production)
EnableSwagger=true

# 6. Dynamic Port (Cloud hosts like Render, Railway, Koyeb set this automatically)
PORT=8080
